OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FLASK_SECRET_KEY=
# Optional browser-test password. Use ${QA_TEST_PASSWORD} in test steps.
QA_TEST_PASSWORD=
# Optional: use an installed browser (e.g. msedge) when Playwright Chromium is not installed.
QA_BROWSER_CHANNEL=
# Link sharing (start_share.cmd): access code visitors must enter (created automatically if empty)
QA_ACCESS_CODE=
# Optional: fixed ngrok domain, e.g. https://your-name.ngrok-free.app
QA_SHARE_DOMAIN=
